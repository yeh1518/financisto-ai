<?xml version="1.0" encoding="utf-8"?>
<!-- 背景用 AI fork 紫底（見 values/colors.xml ai_launcher_background）；前景/monochrome 沿用原本。
     API 26+ adaptive icon 生效；更舊裝置落回 mipmap 的 app_icon.png（那個仍是原底色，可接受）。 -->
