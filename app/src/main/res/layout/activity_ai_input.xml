<?xml version="1.0" encoding="utf-8"?>
<!--
  ai_root 不放 padding：它負責吃 window insets（targetSdk 35+ 在 Android 15
  強制 edge-to-edge，不處理的話內容會畫到狀態列/ActionBar 底下）。
  實際內容的邊距放在內層 container。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_input_hint"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <!-- 輸入框 + 一鍵清空（X）：清空比逐字刪快，接著重講也方便 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <EditText
                android:id="@+id/ai_input_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minLines="2"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:hint="@string/ai_input_placeholder"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/ai_input_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ai_cancel"
                android:contentDescription="@string/ai_input_clear_desc" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <ProgressBar
                android:id="@+id/ai_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleSmall" />

            <TextView
                android:id="@+id/ai_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 中央大錄音鈕。內建模式＝開 Google 語音彈窗；雲端模式＝就地開錄
             （轉紅＋隨音量縮放＋計時，再點一下完成），不疊視窗 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/ai_voice_button"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/btn_ai_mic_circle"
                android:src="@drawable/ic_ai_mic"
                android:scaleType="fitCenter"
                android:padding="48dp"
                android:contentDescription="@string/ai_voice_button_desc" />

            <TextView
                android:id="@+id/ai_voice_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textSize="15sp"
                android:text="@string/ai_voice_tap_to_talk" />

            <!-- 錄音中顯示取消；辨識/解析失敗顯示重試（同一段錄音重送，不用重講）。
                 用 invisible 佔位（非 gone）：麥克風上下高度恆定，紫/紅切換時不會跳動 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/ai_voice_cancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@android:string/cancel"
                    android:visibility="invisible" />

                <Button
                    android:id="@+id/ai_voice_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_rec_retry"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 辨識完直接送解析 vs 停在文字讓使用者接著講/手動送（記在 prefs）。
             textOn/Off 清空 + switchMinWidth：縮窄 Holo Switch（理由見 activity_ai_settings.xml） -->
        <Switch
            android:id="@+id/ai_auto_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:switchMinWidth="52dp"
            android:text="@string/ai_auto_send"
            android:textOff=""
            android:textOn=""
            android:thumbTextPadding="10dp" />

        <!-- 語音直解模式：開關無意義 → 隱藏開關、改顯示這行純說明（見 refreshAutoSendSwitch） -->
        <TextView
            android:id="@+id/ai_direct_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/ai_direct_autosend_note"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ai_parse_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ai_parse" />

            <Button
                android:id="@+id/ai_settings_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/ai_settings" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
