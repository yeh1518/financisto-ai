<?xml version="1.0" encoding="utf-8"?>
<!-- 補充模式的雲端錄音頁（VoiceCaptureActivity）：與主語音頁同款大麥克風。
     進頁即錄，點麥克風＝完成；不疊視窗。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/vc_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <ImageButton
                android:id="@+id/vc_mic"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/btn_ai_mic_circle"
                android:contentDescription="@string/ai_voice_button_desc"
                android:padding="48dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ai_mic" />

            <ProgressBar
                android:id="@+id/vc_busy"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/vc_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/vc_cancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/cancel" />

            <Button
                android:id="@+id/vc_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/ai_rec_retry"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
