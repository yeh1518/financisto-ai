<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) 用的備份/轉移規則；理由同 backup_rules.xml。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
